# A bot of its own, not one of the bots being watched — a watchdog reporting through something it
# watches goes quiet in exactly the case worth hearing about. Get the token from @BotFather.
BOT_TOKEN=

# Where the reports go: your user id, or a group/channel id (negative, e.g. -1001234567890).
# Send /start to the bot first, otherwise Telegram will not let it message you.
CHAT_ID=

# The gid of the host's docker group, used by compose so the container can read the socket as a
# non-root user. Find it with: stat -c '%g' /var/run/docker.sock
DOCKER_GID=

# --- everything below is optional ---

# How this machine is named in the reports. Worth setting once you watch more than one host,
# otherwise two hosts running the same stack send messages you cannot tell apart. Left unset,
# Varta asks the daemon for the host's own name, so a second host usually needs nothing here.
# HOST_LABEL=

# Compose projects to watch, comma-separated. Empty means every container on the host.
# PROJECTS=

# Service or container names to leave out, comma-separated. Use it for anything you keep
# deliberately stopped, which would otherwise be reported as a problem on every boot.
# IGNORE=

# How long to wait for the stack to stop moving before sending the boot report. Also how long a
# service has to keep restarting before it is reported as a crash loop, and how long it then has to
# stay up before it is reported as recovered.
# SETTLE_TIMEOUT_SECONDS=300

# How often to re-read container state.
# POLL_INTERVAL_SECONDS=15

# Path to the docker socket inside the container.
# DOCKER_SOCKET=/var/run/docker.sock

# How stale Varta's own heartbeat may get before its healthcheck fails. Raise it if you set
# POLL_INTERVAL_SECONDS above a couple of minutes.
# HEALTH_STALE_SECONDS=600

# How much Varta writes to its own log: TRACE, DEBUG, INFO, WARN or ERROR. Only affects the log,
# never the reports.
# LOG_LEVEL=INFO
